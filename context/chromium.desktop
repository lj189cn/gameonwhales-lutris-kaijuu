[Desktop Entry]
Version=1.0
Name=Chromium
GenericName=Web Browser
Comment=Open links with Chromium (shared AppImage)
Exec=/usr/local/bin/chromium-open %u
Terminal=false
Type=Application
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;
StartupNotify=false
Categories=Network;WebBrowser;
